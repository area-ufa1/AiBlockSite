{
  "manifest_version": 3,
  "name": "Страж вкладок",
  "version": "0.1.0",
  "description": "Уводит с нежелательных сайтов в Claude с поддерживающим сообщением.",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Страж вкладок",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "offscreen",
    "clipboardWrite"
  ],
  "incognito": "spanning",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/youtube-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/youtube-bridge.js"
      ],
      "css": [
        "content/youtube.css"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
